# Dockerfile for SGLang v0.3.3.post1 (b1709305)
# Commit date: 2024-10-18
# Original deps: vllm==0.5.5
# PR #1697: Radix tree optimization

FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-dev git curl \
    && rm -rf /var/lib/apt/lists/*

# Install torch 2.4.0 (compatible with vllm 0.5.5)
RUN pip3 install --no-cache-dir torch==2.4.0 --index-url https://download.pytorch.org/whl/cu121

# Install vllm 0.5.5
RUN pip3 install --no-cache-dir vllm==0.5.5

# Install flashinfer for torch 2.4
RUN pip3 install --no-cache-dir flashinfer==0.1.6 -i https://flashinfer.ai/whl/cu121/torch2.4/

# Clone and checkout EXACT commit
RUN git clone https://github.com/sgl-project/sglang.git /sglang
WORKDIR /sglang
RUN git checkout b1709305

# PATCH: Fix duplicated model implementation assertion
# Comment out the assert blocks that check for duplicate model registrations
RUN sed -i '/Duplicated model implementation/s/^/# DISABLED: /' python/sglang/srt/model_executor/model_runner.py && \
    sed -i '/assert (/,/Duplicated model implementation/s/^/# DISABLED: /' python/sglang/srt/model_executor/model_runner.py

# PATCH: Fix event loop issue in detokenizer_manager.py
RUN sed -i 's/loop = asyncio.get_event_loop()/loop = asyncio.new_event_loop(); asyncio.set_event_loop(loop)/' \
    python/sglang/srt/managers/detokenizer_manager.py

# Install runtime dependencies (including orjson for this version)
RUN pip3 install --no-cache-dir aiohttp decord fastapi hf_transfer huggingface_hub interegular \
    packaging pillow psutil pydantic python-multipart uvicorn uvloop pyzmq "outlines==0.0.44" orjson

# PATCH: outlines 0.0.44 tries to import types module which requires pyairports (broken package on PyPI)
RUN sed -i '/import outlines.types/d' /usr/local/lib/python3.10/dist-packages/outlines/__init__.py

# Create pyairports mock module (outlines requires it but PyPI package is placeholder)
RUN pip3 install --no-cache-dir airportsdata && \
    mkdir -p /usr/local/lib/python3.10/dist-packages/pyairports && \
    echo "" > /usr/local/lib/python3.10/dist-packages/pyairports/__init__.py && \
    python3 -c "import airportsdata; d=airportsdata.load(); print('AIRPORT_LIST =', list(d.keys()))" > /usr/local/lib/python3.10/dist-packages/pyairports/airports.py

# Set PYTHONPATH and install sglang
ENV PYTHONPATH="/sglang/python:${PYTHONPATH}"
WORKDIR /sglang/python
RUN pip3 install --no-cache-dir .

# Verify installation
RUN python3 -c "import sglang; print(f'SGLang {sglang.__version__}')"

WORKDIR /sglang
