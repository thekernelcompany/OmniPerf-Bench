# Dockerfile for SGLang v0.3.0 (ab4a83b2)
# Commit date: 2024-09-05
# Original deps: vllm==0.5.5, outlines>=0.0.44

FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install system deps
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-dev git curl \
    && rm -rf /var/lib/apt/lists/*

# Install torch 2.4.0 (compatible with vllm 0.5.5)
RUN pip3 install --no-cache-dir torch==2.4.0 --index-url https://download.pytorch.org/whl/cu121

# Install vllm 0.5.5 (what v0.3.0 expects)
RUN pip3 install --no-cache-dir vllm==0.5.5

# Install flashinfer for torch 2.4
RUN pip3 install --no-cache-dir flashinfer==0.1.6 -i https://flashinfer.ai/whl/cu121/torch2.4/

# Clone and checkout EXACT commit
RUN git clone https://github.com/sgl-project/sglang.git /sglang
WORKDIR /sglang
RUN git checkout ab4a83b2

# Verify we have the right commit (no vocab_parallel_embedding.py)
RUN test ! -f python/sglang/srt/layers/vocab_parallel_embedding.py || (echo "ERROR: Wrong commit" && exit 1)

# Install sglang from source
# First install runtime deps, then install sglang package
RUN pip3 install --no-cache-dir aiohttp decord fastapi hf_transfer huggingface_hub interegular \
    packaging pillow psutil pydantic python-multipart uvicorn uvloop pyzmq "outlines>=0.0.44"

# Create pyairports mock module (outlines requires it but PyPI package is placeholder)
RUN pip3 install --no-cache-dir airportsdata && \
    mkdir -p /usr/local/lib/python3.10/dist-packages/pyairports && \
    echo "" > /usr/local/lib/python3.10/dist-packages/pyairports/__init__.py && \
    python3 -c "import airportsdata; d=airportsdata.load(); print('AIRPORT_LIST =', list(d.keys()))" > /usr/local/lib/python3.10/dist-packages/pyairports/airports.py

# Set PYTHONPATH to include the sglang python directory
ENV PYTHONPATH="/sglang/python:${PYTHONPATH}"

# Install sglang package using pip install . from inside the directory
WORKDIR /sglang/python
RUN pip3 install --no-cache-dir .

# Verify installation
RUN python3 -c "import sglang; print(f'SGLang {sglang.__version__}')"

WORKDIR /sglang
