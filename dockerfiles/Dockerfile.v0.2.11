# Dockerfile for SGLang v0.2.11 (62757db6)
# Commit date: 2024-08-09
# Original deps: vllm==0.5.4, outlines>=0.0.44

FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install system deps
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-dev git curl \
    && rm -rf /var/lib/apt/lists/*

# Install torch 2.3.0 (compatible with vllm 0.5.4)
RUN pip3 install --no-cache-dir torch==2.3.0 --index-url https://download.pytorch.org/whl/cu121

# Install vllm 0.5.4 (what v0.2.11 expects)
RUN pip3 install --no-cache-dir vllm==0.5.4

# Install flashinfer for torch 2.3
RUN pip3 install --no-cache-dir flashinfer==0.1.6 -i https://flashinfer.ai/whl/cu121/torch2.3/

# Clone and checkout EXACT commit
RUN git clone https://github.com/sgl-project/sglang.git /sglang
WORKDIR /sglang
RUN git checkout 62757db6

# PATCH: Fix event loop issue in detokenizer_manager.py
# Line 175: asyncio.get_event_loop() -> asyncio.new_event_loop() + set
RUN sed -i 's/loop = asyncio.get_event_loop()/loop = asyncio.new_event_loop(); asyncio.set_event_loop(loop)/' \
    python/sglang/srt/managers/detokenizer_manager.py

# Verify patch was applied
RUN grep -q "new_event_loop" python/sglang/srt/managers/detokenizer_manager.py || (echo "Patch failed" && exit 1)

# Install runtime dependencies
RUN pip3 install --no-cache-dir aiohttp decord fastapi hf_transfer huggingface_hub interegular \
    packaging pillow psutil pydantic python-multipart uvicorn uvloop pyzmq "outlines>=0.0.44"

# Create pyairports mock module (outlines requires it but PyPI package is placeholder)
RUN pip3 install --no-cache-dir airportsdata && \
    mkdir -p /usr/local/lib/python3.10/dist-packages/pyairports && \
    echo "" > /usr/local/lib/python3.10/dist-packages/pyairports/__init__.py && \
    python3 -c "import airportsdata; d=airportsdata.load(); print('AIRPORT_LIST =', list(d.keys()))" > /usr/local/lib/python3.10/dist-packages/pyairports/airports.py

# Set PYTHONPATH and install sglang
ENV PYTHONPATH="/sglang/python:${PYTHONPATH}"
WORKDIR /sglang/python
RUN pip3 install --no-cache-dir .

# Verify installation
RUN python3 -c "import sglang; print(f'SGLang {sglang.__version__}')"

WORKDIR /sglang
