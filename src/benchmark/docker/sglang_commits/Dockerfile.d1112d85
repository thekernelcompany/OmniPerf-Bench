# Dockerfile for SGLang commit d1112d8548eb13c842900b3a8d622345f9737759
# SGLang: 0.4.4.post1, sgl-kernel: 0.0.5.post2, torch: 2.5.1
# Also works for parent commit: 48efec7b052354865aa2f0605a5bf778721f3cbb
#
# Version compatibility (from pytorch/ao#2919 and pyproject.toml):
#   torch==2.5.1, torchao==0.12.0, vllm>=0.6.4.post1,<=0.7.2, transformers==4.48.3
#
# KNOWN ISSUE: torch 2.5.1 bundles triton 3.1.0 which segfaults on H100/SM90 GPUs
# See BUILD_STATUS.md for details and potential fixes

ARG CUDA_VERSION=12.4.1
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu22.04

ARG COMMIT_HASH=d1112d8548eb13c842900b3a8d622345f9737759

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    PATH="${PATH}:/usr/local/cuda/bin" \
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/cuda/lib64" \
    MAX_JOBS=8 \
    CMAKE_BUILD_PARALLEL_LEVEL=8

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3.11-venv python3-pip \
    git curl wget build-essential cmake ninja-build \
    libopenmpi-dev libnuma-dev \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install pip and build dependencies
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && pip install scikit-build-core ninja cmake uv numpy

# Install PyTorch 2.5.1 (required for sgl-kernel 0.0.5.post2)
# NOTE: This bundles triton 3.1.0 which has H100 segfault issues
RUN pip install torch==2.5.1 --index-url https://download.pytorch.org/whl/cu124

# Clone SGLang at specific commit
WORKDIR /opt
RUN git clone https://github.com/sgl-project/sglang.git sglang \
    && cd sglang \
    && git checkout ${COMMIT_HASH} \
    && git submodule update --init --recursive || true

# BUILD sgl-kernel FROM SOURCE (the key fix!)
# This ensures ABI compatibility with the torch version
WORKDIR /opt/sglang/sgl-kernel
RUN pip install . --no-build-isolation -v 2>&1 | tee /tmp/sgl_kernel_build.log || \
    (echo "sgl-kernel build failed, trying with fresh scikit-build-core" && \
     pip install --force-reinstall scikit-build-core && \
     pip install . -v)

# Note: sgl_kernel import requires GPU driver (libcuda.so.1) - will be verified at runtime

# Install flashinfer for torch 2.5
WORKDIR /opt/sglang
RUN pip install flashinfer-python==0.2.3 -i https://flashinfer.ai/whl/cu124/torch2.5/ || \
    pip install flashinfer-python -i https://flashinfer.ai/whl/cu124/torch2.5/ || \
    echo "Warning: flashinfer installation failed, SGLang may fall back to other backends"

# Install SGLang runtime dependencies
# Versions from pyproject.toml and pytorch/ao#2919 compatibility table:
#   - torchao==0.12.0: Official compatible version for torch 2.5.x (see https://github.com/pytorch/ao/issues/2919)
#   - vllm>=0.6.4.post1,<=0.7.2: Required by SGLang 0.4.4.post1
#   - transformers==4.48.3: Pinned in pyproject.toml
RUN pip install "torchao==0.12.0" "transformers==4.48.3" "vllm>=0.6.4.post1,<=0.7.2" \
    "huggingface_hub>=0.23.0" "tokenizers>=0.19.0" "accelerate>=0.30.0" "numpy<2.0" \
    requests aiohttp triton packaging xgrammar pydantic fastapi uvicorn uvloop httptools \
    orjson setproctitle IPython pyzmq pillow psutil compressed-tensors \
    python-multipart sse-starlette interegular "outlines>=0.0.44,<=0.1.11" \
    partial_json_parser einops msgspec pyairports pycountry || true

# Install SGLang from source (sgl-kernel already installed, pip won't reinstall it)
RUN pip install -e "python[srt]" --no-deps || pip install -e "python" --no-deps

# Install any remaining sglang dependencies (but not sgl-kernel or torch)
RUN pip install datasets pandas tqdm pybase64 Pillow hf_transfer modelscope pynvml \
    prometheus-client decord soundfile cuda-python || true

# Verify SGLang and torch installation (sgl_kernel verification requires GPU runtime)
RUN python -c "import sglang; print(f'SGLang version: {sglang.__version__}')" && \
    python -c "import torch; print(f'torch: {torch.__version__}')"

# Set working directory for benchmarks
WORKDIR /workspace

# Copy benchmark scripts from SGLang repo
RUN cp -r /opt/sglang/python/sglang/bench_* /workspace/ 2>/dev/null || true
RUN cp -r /opt/sglang/benchmark* /workspace/ 2>/dev/null || true
RUN cp -r /opt/sglang/benchmarks /workspace/ 2>/dev/null || true

CMD ["python", "-c", "import sglang; import sgl_kernel; print(f'SGLang {sglang.__version__} with sgl_kernel ready')"]
