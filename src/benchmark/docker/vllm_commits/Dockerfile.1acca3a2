# SGLang Docker image for commit 1acca3a2c685221cdb181c2abda4f635e1ead435
# Date: 2025-05-02
# SGLang version: 0.4.6.post2
# torch: 2.6.0, flashinfer_python: 0.2.5, sgl-kernel: 0.1.1
#
# Source: ayushnangia/vllm-docker-build (2025-05-02)
# MODIFIED: Using cu124 instead of cu118 to match base image CUDA 12.4
#
# This version uses torch 2.6.0 which has proper cu124 wheels!

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Build arguments
ARG MAX_JOBS=8
ARG TORCH_CUDA_ARCH_LIST="9.0"
ARG COMMIT_HASH=1acca3a2c685221cdb181c2abda4f635e1ead435

# Environment variables
ENV TORCH_CUDA_ARCH_LIST="9.0"
ENV MAX_JOBS=8
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${PATH}:/usr/local/cuda/bin"
ENV LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/cuda/lib64"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    wget \
    vim \
    cmake \
    ninja-build \
    software-properties-common \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    python3-pip \
    libibverbs-dev \
    libopenmpi-dev \
    libnuma-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set Python 3.10 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1

# Upgrade pip and install build tools
RUN python3 -m pip install --upgrade pip setuptools wheel

# Install torch 2.6.0 with CUDA 12.4 (PROPER MATCH with base image!)
RUN pip3 install torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cu124

# Install sgl-kernel 0.1.1 from PyPI
RUN pip3 install sgl-kernel==0.1.1

# Install core dependencies (from constraints file in original)
RUN pip3 install \
    fastapi==0.110.3 \
    uvicorn==0.29.0 \
    pydantic==2.7.1 \
    pydantic-core==2.18.2 \
    typing_extensions==4.11.0 \
    outlines==0.0.44 \
    pyzmq==26.0.3 \
    "transformers>=4.52.4" \
    xgrammar==0.1.17 \
    blobfile==3.0.0 \
    soundfile==0.13.1 \
    "torchao>=0.9.0" \
    einops \
    partial_json_parser \
    cuda-python \
    "numpy<2.0" \
    packaging \
    ninja

# Install remaining dependencies
RUN pip3 install \
    huggingface_hub datasets orjson pillow psutil pynvml \
    python-multipart uvloop aiohttp requests tqdm setproctitle \
    IPython interegular "prometheus-client>=0.20.0" \
    "llguidance>=0.7.11,<0.8.0" compressed-tensors \
    decord hf_transfer modelscope msgspec || true

# Build flashinfer 0.2.5 from source
# v0.2.5 has pyproject.toml at root level
WORKDIR /sgl-workspace
RUN git clone --recursive https://github.com/flashinfer-ai/flashinfer.git && \
    cd flashinfer && \
    git checkout v0.2.5 && \
    git submodule update --init --recursive && \
    MAX_JOBS=${MAX_JOBS} TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST}" \
    pip3 install -e . --no-build-isolation && \
    rm -rf .git

# Clone SGLang and checkout commit
RUN git clone https://github.com/sgl-project/sglang.git sglang && \
    cd sglang && \
    git checkout ${COMMIT_HASH}

# Verify checkout
RUN cd /sgl-workspace/sglang && \
    ACTUAL=$(git rev-parse HEAD) && \
    echo "Checked out: $ACTUAL"

# Install SGLang
WORKDIR /sgl-workspace/sglang/python
RUN pip3 install -e . --no-deps

# For openbmb/MiniCPM models
RUN pip3 install datamodel_code_generator || true

# Verify installation
RUN python3 -c "import sglang; print(f'SGLang version: {sglang.__version__}')" && \
    python3 -c "import torch; print(f'torch: {torch.__version__}')" && \
    python3 -c "import triton; print(f'triton: {triton.__version__}')"

WORKDIR /workspace
CMD ["/bin/bash"]
