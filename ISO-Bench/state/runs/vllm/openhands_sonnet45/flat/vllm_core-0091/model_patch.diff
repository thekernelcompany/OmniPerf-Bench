@@ -66,7 +66,8 @@ class Sampler(nn.Module):
         temp: torch.Tensor,
     ) -> torch.Tensor:
         # Avoid division by zero.
-        temp = torch.where(temp < _SAMPLING_EPS, 1.0, temp)
