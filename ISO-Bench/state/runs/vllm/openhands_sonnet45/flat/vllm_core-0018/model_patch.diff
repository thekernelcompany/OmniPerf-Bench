+# SPDX-License-Identifier: Apache-2.0
+
+import pytest
+import torch
+
+from vllm.v1.sample.ops.topk_topp_sampler import (
+    TopKTopPSampler, apply_top_k_top_p, random_sample
+)
+
+VOCAB_SIZE = 1024
+CUDA_DEVICES = [
+    f"cuda:{i}" for i in range(1 if torch.cuda.device_count() == 1 else 2)
+]
+
+
+@pytest.mark.parametrize("device", CUDA_DEVICES)
+@pytest.mark.parametrize("batch_size", [1, 8, 32])
+def test_apply_top_k(device: str, batch_size: int):
+    """Test that top-k filtering works correctly."""
+    torch.set_default_device(device)
+    
+    # Create logits with known values
+    logits = torch.randn(batch_size, VOCAB_SIZE)
+    k = torch.tensor([10] * batch_size)
+    
+    # Apply top-k
+    filtered_logits = apply_top_k_top_p(logits.clone(), k, None)
+    
+    # Check that only top-k values are not -inf
+    for i in range(batch_size):
+        sorted_logits, _ = logits[i].sort(descending=True)
+        threshold = sorted_logits[9]  # 10th largest value (0-indexed)
+        
+        # Count non-inf values
+        non_inf_count = (filtered_logits[i] != float('-inf')).sum().item()
+        assert non_inf_count == 10, f"Expected 10 non-inf values, got {non_inf_count}"
+        
+        # Check that all values below threshold are -inf
+        below_threshold = logits[i] < threshold
+        assert (filtered_logits[i][below_threshold] == float('-inf')).all()
+
+
+@pytest.mark.parametrize("device", CUDA_DEVICES)
+@pytest.mark.parametrize("batch_size", [1, 8, 32])
+def test_apply_top_p(device: str, batch_size: int):
+    """Test that top-p filtering works correctly."""
+    torch.set_default_device(device)
+    
+    # Create logits with known values
+    logits = torch.randn(batch_size, VOCAB_SIZE)
+    p = torch.tensor([0.9] * batch_size)
+    
+    # Apply top-p
+    filtered_logits = apply_top_k_top_p(logits.clone(), None, p)
+    
+    # Check that at least one value is not -inf
+    for i in range(batch_size):
+        non_inf_count = (filtered_logits[i] != float('-inf')).sum().item()
+        assert non_inf_count >= 1, f"Expected at least 1 non-inf value, got {non_inf_count}"
+        
+        # Verify that the cumulative probability of non-inf values is >= p
+        probs = torch.softmax(logits[i], dim=-1)
+        sorted_probs, sorted_indices = probs.sort(descending=True)
+        cumsum = sorted_probs.cumsum(dim=-1)
+        
+        # Find how many tokens are needed to reach p
+        num_tokens_needed = (cumsum <= 0.9).sum().item() + 1
+        
+        # The filtered logits should have at least this many non-inf values
+        assert non_inf_count >= num_tokens_needed
+
+
+@pytest.mark.parametrize("device", CUDA_DEVICES)
+@pytest.mark.parametrize("batch_size", [1, 8, 32])
+def test_apply_top_k_top_p(device: str, batch_size: int):
+    """Test that combined top-k and top-p filtering works correctly."""
+    torch.set_default_device(device)
+    
+    # Create logits with known values
+    logits = torch.randn(batch_size, VOCAB_SIZE)
+    k = torch.tensor([50] * batch_size)
+    p = torch.tensor([0.9] * batch_size)
+    
+    # Apply both top-k and top-p
+    filtered_logits = apply_top_k_top_p(logits.clone(), k, p)
+    
+    # Check that the number of non-inf values is <= k
+    for i in range(batch_size):
+        non_inf_count = (filtered_logits[i] != float('-inf')).sum().item()
+        assert non_inf_count <= 50, f"Expected at most 50 non-inf values, got {non_inf_count}"
+        assert non_inf_count >= 1, f"Expected at least 1 non-inf value, got {non_inf_count}"
+
+
+@pytest.mark.parametrize("device", CUDA_DEVICES)
+@pytest.mark.parametrize("batch_size", [1, 8, 32])
+def test_random_sample_no_generators(device: str, batch_size: int):
+    """Test random sampling without custom generators."""
+    torch.set_default_device(device)
+    
+    # Create probability distribution
+    logits = torch.randn(batch_size, VOCAB_SIZE)
+    probs = torch.softmax(logits, dim=-1)
+    
+    # Sample without generators
+    sampled = random_sample(probs.clone(), {})
+    
+    # Check output shape and type
+    assert sampled.shape == (batch_size,)
+    assert sampled.dtype == torch.int64
+    
+    # Check that all sampled indices are valid
+    assert (sampled >= 0).all()
+    assert (sampled < VOCAB_SIZE).all()
+
+
+@pytest.mark.parametrize("device", CUDA_DEVICES)
+@pytest.mark.parametrize("batch_size", [8, 32])
+def test_random_sample_with_generators(device: str, batch_size: int):
+    """Test random sampling with custom generators."""
+    torch.set_default_device(device)
+    
+    # Create probability distribution
+    logits = torch.randn(batch_size, VOCAB_SIZE)
+    probs = torch.softmax(logits, dim=-1)
+    
+    # Create generators for some requests
+    generators = {}
+    for i in range(batch_size // 2):
+        generators[i] = torch.Generator(device=device)
+        generators[i].manual_seed(42)
+    
+    # Sample with generators
+    sampled = random_sample(probs.clone(), generators)
+    
+    # Check output shape and type
+    assert sampled.shape == (batch_size,)
+    assert sampled.dtype == torch.int64
+    
+    # Check that all sampled indices are valid
+    assert (sampled >= 0).all()
+    assert (sampled < VOCAB_SIZE).all()
+    
+    # Test reproducibility for requests with generators
+    sampled2 = random_sample(probs.clone(), generators)
+    # Note: Due to the way generators work, we can't guarantee exact reproducibility
+    # without resetting the generator state, but we can check validity
+
+
+@pytest.mark.parametrize("device", CUDA_DEVICES)
+@pytest.mark.parametrize("batch_size", [1, 8, 32])
+def test_topk_topp_sampler_forward_native(device: str, batch_size: int):
+    """Test the TopKTopPSampler forward_native method."""
+    torch.set_default_device(device)
+    
+    sampler = TopKTopPSampler()
+    
+    # Test with top-k only
+    logits = torch.randn(batch_size, VOCAB_SIZE)
+    k = torch.tensor([50] * batch_size)
+    sampled = sampler.forward_native(logits.clone(), {}, k, None)
+    
+    assert sampled.shape == (batch_size,)
+    assert (sampled >= 0).all()
+    assert (sampled < VOCAB_SIZE).all()
+    
+    # Test with top-p only
+    p = torch.tensor([0.9] * batch_size)
+    sampled = sampler.forward_native(logits.clone(), {}, None, p)
+    
+    assert sampled.shape == (batch_size,)
+    assert (sampled >= 0).all()
+    assert (sampled < VOCAB_SIZE).all()
+    
+    # Test with both top-k and top-p
+    sampled = sampler.forward_native(logits.clone(), {}, k, p)
+    
+    assert sampled.shape == (batch_size,)
+    assert (sampled >= 0).all()
+    assert (sampled < VOCAB_SIZE).all()
+
+
+@pytest.mark.parametrize("device", CUDA_DEVICES)
+def test_apply_top_k_top_p_no_filtering(device: str):
+    """Test that no filtering is applied when k and p are None."""
+    torch.set_default_device(device)
+    
+    batch_size = 8
+    logits = torch.randn(batch_size, VOCAB_SIZE)
+    
+    # Apply with both None
+    filtered_logits = apply_top_k_top_p(logits.clone(), None, None)
+    
+    # Check that logits are unchanged
+    assert torch.allclose(filtered_logits, logits)
+
+
+@pytest.mark.parametrize("device", CUDA_DEVICES)
+def test_random_sample_deterministic_with_seed(device: str):
+    """Test that random sampling is deterministic with the same seed."""
+    torch.set_default_device(device)
+    
+    batch_size = 8
+    logits = torch.randn(batch_size, VOCAB_SIZE)
+    probs = torch.softmax(logits, dim=-1)
+    
+    # Create generators with same seed
+    generators1 = {i: torch.Generator(device=device).manual_seed(42) for i in range(batch_size)}
+    generators2 = {i: torch.Generator(device=device).manual_seed(42) for i in range(batch_size)}
+    
+    # Sample twice with same seed
+    sampled1 = random_sample(probs.clone(), generators1)
+    sampled2 = random_sample(probs.clone(), generators2)
+    
+    # Results should be identical
+    assert torch.equal(sampled1, sampled2)
