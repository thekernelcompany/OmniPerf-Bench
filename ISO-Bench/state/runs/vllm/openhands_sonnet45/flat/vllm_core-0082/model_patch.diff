+    def get_first_seq_with_status(
+        self,
+        status: SequenceStatus,
+    ) -> Optional[Sequence]:
+        """Get the first sequence with the given status without creating a list."""
+        if self.is_single_seq:
+            return self.seqs[0] if self.seqs[0].status == status else None
+        
+        for seq in self.seqs:
+            if seq.status == status:
+                return seq
+        return None
+
     def is_encoder_decoder(self) -> bool:
         return self.encoder_seq is not None
 
