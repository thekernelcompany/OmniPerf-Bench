-  auto blk_coord = make_coord(blockIdx.x, blockIdx.y, blockIdx.z);
-  auto tB_in = local_tile(
-      B_in, append(typename PrepackedLayoutB::PPBlockShape_NK{}, _1{}),
-      blk_coord);
