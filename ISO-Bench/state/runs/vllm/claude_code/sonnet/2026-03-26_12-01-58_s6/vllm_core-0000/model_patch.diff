-                                           req_state.prompt_len,
-                                           req_state.stats, lora_stats)
-
-    def _update_stats_from_finished(self, req_state: RequestState,
-                                    finish_reason: Optional[FinishReason],
-                                    iteration_stats: Optional[IterationStats]):
