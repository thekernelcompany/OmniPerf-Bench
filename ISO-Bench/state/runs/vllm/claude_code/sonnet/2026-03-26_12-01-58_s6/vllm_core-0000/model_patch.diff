-    if ((ret != NVML_SUCCESS) and
-        (ret != NVML_ERROR_INSUFFICIENT_SIZE)):
-        raise NVMLError(ret)
-
-    # call again with a buffer
-    # oversize the array for the rare cases where additional pages
