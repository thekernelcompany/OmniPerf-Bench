-            self.q_norm = RMSNorm(config.hidden_size,
-                                  eps=config.layer_norm_eps)
-
-        # Rotary embeddings.
-        self.rotary_emb = get_rope(
-            self.head_dim,
-            rotary_dim=self.head_dim,
-            max_position=self.max_position_embeddings,
-            base=self.rope_theta,
