-                                  text_hidden_size,
-                                  bias=multimodal_projector_bias)
-        self.act = get_act_fn(projector_hidden_act)
-        self.linear_2 = nn.Linear(text_hidden_size,
-                                  text_hidden_size,
-                                  bias=multimodal_projector_bias)
