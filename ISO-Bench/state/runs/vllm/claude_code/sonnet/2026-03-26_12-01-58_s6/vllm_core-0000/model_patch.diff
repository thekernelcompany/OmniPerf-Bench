-def flatten_bn(
-    x: Union[List[torch.Tensor], torch.Tensor],
-    *,
-    concat: bool = False,
-) -> Union[List[torch.Tensor], torch.Tensor]:
-    """
-    Flatten the ``B`` and ``N`` dimensions of batched multimodal inputs.
-
-    The input tensor should have shape ``(B, N, ...)```.
-    """
-    if isinstance(x, torch.Tensor):
