-            self.attn_state.begin_forward(model_input)
-
-        # Detect exec mode
-        assert model_input.attn_metadata is not None
-        use_cuda_graph = False
-        if model_input.attn_metadata.num_prefills > 0:
-            # In this case, execute_model(..) was called directly
-            if num_steps > 1:
