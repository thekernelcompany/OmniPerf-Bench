-    prev_lps = 0  # length of the previous longest prefix suffix
-    i = 1
-
-    while i < len(pattern):
-        if pattern[i] == pattern[prev_lps]:
-            prev_lps += 1
-            lps[i] = prev_lps
-            i += 1
-        else:
-            if prev_lps != 0:
-                prev_lps = lps[prev_lps - 1]
-            else:
-                lps[i] = 0
-                i += 1
-    return lps
