-  for (int i = 0; i < 2; ++i) {
-    int dst_row_kidx = dst_row_base_kidx + i * 32;
-    int dst_offset = dst_row_kidx * N + dst_col_nidx;
-    if (dst_row_kidx < K && dst_col_nidx < N) {
-      *reinterpret_cast<uint4*>(fdata + dst_offset) =
-          *reinterpret_cast<uint4*>(fval_reg + i * 8);
-    }
-  }
-}
