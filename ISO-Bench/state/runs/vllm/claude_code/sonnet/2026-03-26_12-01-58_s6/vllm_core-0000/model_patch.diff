-  blockDim.x = BLOCK_SIZE_N;
-  blockDim.y = 1;
-  blockDim.z = 1;
-  gridDim.x = num_token_blocks;
-  gridDim.y = DIVIDE(size_n, BLOCK_SIZE_N);
-  gridDim.z = DIVIDE(size_k, BLOCK_SIZE_K);
