-        nrows, ncols = get_patches_grid_size(
-            tiling_h=tiling_h,
-            tiling_w=tiling_w,
-            crop_patches=crop_patches,
-            left_margin=left_margin,
-            right_margin=right_margin,
-            pooling_size=pooling_size,
