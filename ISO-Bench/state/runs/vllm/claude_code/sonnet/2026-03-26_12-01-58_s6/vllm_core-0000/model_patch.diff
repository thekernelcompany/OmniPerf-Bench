-            gpu_prefix_cache_hit_rate=gpu_prefix_cache_hit_rate,
-
-            # Iteration stats
-            num_prompt_tokens_iter=num_prompt_tokens_iter,
-            num_generation_tokens_iter=num_generation_tokens_iter,
