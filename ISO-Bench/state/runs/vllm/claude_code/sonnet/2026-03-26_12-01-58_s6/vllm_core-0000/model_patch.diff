-        allocator: BlockAllocator,
-        block_id: Optional[int] = None,
-        computed: bool = False,
-        extra_hash: Optional[int] = None,
-    ) -> Block:
-        # Bind block to self.
-        allocator = self
-
-        return PrefixCachingBlock(
-            prev_block=prev_block,
-            token_ids=token_ids,
-            block_size=block_size,
-            block_id=block_id,
-            allocator=allocator,
-            computed=computed,
-            extra_hash=extra_hash,
-        )
