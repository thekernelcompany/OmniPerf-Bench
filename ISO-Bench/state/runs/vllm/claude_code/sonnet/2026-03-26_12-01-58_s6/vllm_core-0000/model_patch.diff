-            params.z_d_stride = z.stride(1);
-            params.out_z_batch_stride = out_z.stride(0);
-            params.out_z_d_stride = out_z.stride(1);
-        }
-        params.out_batch_stride = out.stride(0);
-        params.out_d_stride = out.stride(1);
-    }
-}
