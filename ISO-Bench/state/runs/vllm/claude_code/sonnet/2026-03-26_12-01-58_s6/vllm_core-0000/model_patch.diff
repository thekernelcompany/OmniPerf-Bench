-            vocab_size = tokenizer.vocab_size
-            # Generate a synthetic prompt: a list of token IDs computed as (i +
-            # j) modulo vocab_size.
-            token_ids = [(i + j) % vocab_size for j in range(input_len)]
-            prompt = tokenizer.decode(token_ids)
-            samples.append(
-                SampleRequest(
-                    prompt=prompt,
-                    prompt_len=input_len,
