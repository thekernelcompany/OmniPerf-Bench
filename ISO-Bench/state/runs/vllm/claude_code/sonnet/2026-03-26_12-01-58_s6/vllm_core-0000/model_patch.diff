-def get_activation(name="relu"):
-    """Select an activation function by name
-
-    Args:
-        name: str
-            activation function name,
-            one of ["relu", "gelu", "swish", "sigmoid"],
-            default "relu".
-    """
-    name = name.lower()
-    if name == "relu":
-        return nn.ReLU(inplace=True)
-    if name == "gelu":
-        return nn.GELU()
-    if name == "swish":
-        return Swish()
-    if name == "sigmoid":
-        return torch.nn.Sigmoid()
-    return nn.Identity()
