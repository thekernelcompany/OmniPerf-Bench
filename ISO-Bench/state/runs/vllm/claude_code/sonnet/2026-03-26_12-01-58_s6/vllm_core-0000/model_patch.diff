-@contextmanager
-def time_counter(enable: bool):
-    if enable:
-        import time
-        start_time = time.time()
-        yield
-        elapsed_time = time.time() - start_time
-        print("-" * 50)
-        print("-- generate time = {}".format(elapsed_time))
-        print("-" * 50)
-    else:
-        yield
