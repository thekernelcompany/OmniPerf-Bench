-class GLULinear(nn.Module):
-    """Linear + GLU module
-
-    Args:
-        input_dim: int
-            input size
-        output_dim: int
-            output size.
-        glu_type:
-            activation function name used in glu module.
-            default "sigmoid" (swish function).
-        bias_in_glu: bool, optional
-            If True, the addtive bias is added. Default False.
-    """
-
-    def __init__(
-        self,
-        input_dim,
-        output_dim,
-        glu_type="sigmoid",
-        bias_in_glu=True,
-    ):
-        super().__init__()
-        self.linear = nn.Linear(input_dim, output_dim * 2, bias_in_glu)
-        self.glu_act = GLU(-1, glu_type)
-
-    def forward(self, x):
-        """GLULinear forward
-
-        Args:
-            x: torch.Tensor
-                inpute tensor.
-        """
-        x = self.linear(x)
-        return self.glu_act(x)
