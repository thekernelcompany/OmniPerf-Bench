-                   (A_ldg_guard & (1u << i)) != 0);
-    }
-
-  #pragma unroll
-    for (int i = 0; i < (Ntile + N_SIZE_ONE_LOAD - 1) / N_SIZE_ONE_LOAD; ++i) {
