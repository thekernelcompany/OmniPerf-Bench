-  TORCH_CHECK(
-      (B.size(0) * eles_per_storage) % size<1>(PPBlockShape_NK{}) == 0,
-      "B.shape[0] (in terms of unpacked elements) must be a multiple of ",
-      size<1>(PPBlockShape_NK{}));
