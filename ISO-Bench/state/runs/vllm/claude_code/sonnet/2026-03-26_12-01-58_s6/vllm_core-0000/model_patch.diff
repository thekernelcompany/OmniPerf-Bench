-
-        # Respect top_k
-        if top_k:
-            trace_dfs = list(
-                map(
-                    lambda trace_df: keep_only_top_entries(
-                        trace_df, "cuda_time_us", top_k), trace_dfs))
-
-        # Fill in information about the step-keys
-        for trace_df, step_key in zip(trace_dfs, step_keys):
