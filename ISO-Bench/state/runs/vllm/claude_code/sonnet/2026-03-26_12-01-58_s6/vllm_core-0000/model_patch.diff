-              "size_k must divisible by BLOCK_SIZE_K");
-  TORCH_CHECK(BLOCK_SIZE_K % group_size == 0,
-              "BLOCK_SIZE_K must divisible by group_size");
-  TORCH_CHECK(BLOCK_SIZE_M <= 64, "BLOCK_SIZE_M must less or equal to 64");
