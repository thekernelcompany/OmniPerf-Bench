-                       std::is_same_v<quant_type_t, c10::Float8_e4m3fnuz>>> {
-  static __device__ __forceinline__ quant_type_t quant_fn(float const x,
-                                                          float const scale) {
-    if constexpr (is_scale_inverted) {
-      return float_to_fp8<quant_type_t>(x * scale);
-    } else {
-      return float_to_fp8<quant_type_t>(x / scale);
-    }
-  }
