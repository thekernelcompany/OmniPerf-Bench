-        params.out_batch_stride = out.stride(1);
-        params.out_d_stride = out.stride(0);
-
-    }
-    else{
-        if (!is_variable_B) {
-            params.B_d_stride = B.stride(0);
-        } else {
-            params.B_batch_stride = B.stride(0);
