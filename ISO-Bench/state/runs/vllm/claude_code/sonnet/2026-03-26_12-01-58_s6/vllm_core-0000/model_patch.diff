-    outputs = llm.generate(
-        {
-            "prompt": req_data.prompt,
-            "multi_modal_data": {
-                "image": req_data.image_data
-            },
-        },
-        sampling_params=sampling_params,
-        lora_request=req_data.lora_requests,
-    )
-
-    print("-" * 50)
