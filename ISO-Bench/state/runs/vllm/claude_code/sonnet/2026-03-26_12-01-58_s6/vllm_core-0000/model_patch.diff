-        self._worker = worker
-        self._draft_ranks = draft_ranks
-
-        # init during init_device
-        self._is_dummy = False
-        self._tp_group = None
-
-    def _patch_tensor_parallel_group(self):
-        """Temporarily patch the global tp group state with its own tp group
