-
-    def __init__(self, quant_config: BitsAndBytesConfig):
-        try:
-            import bitsandbytes
-            if bitsandbytes.__version__ < "0.45.3":
-                raise ImportError("bitsandbytes version is wrong. Please "
-                                  "install bitsandbytes>=0.45.3.")
-        except ImportError as err:
