-    elif protocol == "http/protobuf":
-        from opentelemetry.exporter.otlp.proto.http.trace_exporter import (
-            OTLPSpanExporter)  # type: ignore
-    else:
-        raise ValueError(
-            f"Unsupported OTLP protocol '{protocol}' is configured")
