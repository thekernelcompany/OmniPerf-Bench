@@ -45,12 +45,22 @@ def apply_penalties(logits: torch.Tensor, prompt_tokens_tensor: torch.Tensor,
                                                    vocab_size, num_seqs)
     output_bin_counts, output_mask = get_token_bin_counts_and_mask(
         output_tokens_tensor, vocab_size, num_seqs)
-    repetition_penalties = repetition_penalties.unsqueeze(dim=1).repeat(
-        1, vocab_size)
-    logits[logits > 0] /= torch.where(prompt_mask | output_mask,
-                                      repetition_penalties, 1.0)[logits > 0]
-    logits[logits <= 0] *= torch.where(prompt_mask | output_mask,
-                                       repetition_penalties, 1.0)[logits <= 0]
+    # Use unsqueeze without repeat to avoid allocating a full [num_seqs,
+    # vocab_size] tensor; broadcasting handles the expansion implicitly.
+    rep_pen = repetition_penalties.unsqueeze(dim=1)  # [num_seqs, 1]
+    combined_mask = prompt_mask | output_mask  # compute once, reuse below
+    # Merge the two conditional penalty branches into a single element-wise
+    # multiply so that (a) combined_mask is evaluated once, and (b) fancy
+    # boolean indexing (which copies data) is avoided entirely.
+    #   token in mask, logit > 0  -> multiply by 1/rep_pen  (= divide)
+    #   token in mask, logit <= 0 -> multiply by rep_pen
+    #   token not in mask         -> multiply by 1.0 (no-op)
+    factor = torch.where(
+        combined_mask,
+        torch.where(logits > 0, rep_pen.reciprocal(), rep_pen),
+        torch.ones(1, dtype=logits.dtype, device=logits.device),
+    )
+    logits *= factor
     # We follow the definition in OpenAI API.
     # Refer to https://platform.openai.com/docs/api-reference/parameter-details
