+    # Compute per-sequence token counts using a single bincount over an
+    # offset-augmented tensor. This avoids materializing large one-hot tensors
+    # and repeated scatter_add operations.
+    device = tokens.device
+    # Offsets ensure tokens from different sequences map to disjoint bins.
+    offsets = (torch.arange(num_seqs, device=device, dtype=tokens.dtype)
+               * (vocab_size + 1)).view(-1, 1)
+    flat_ids = (tokens + offsets).reshape(-1)
+    counts = torch.bincount(flat_ids,
+                            minlength=num_seqs * (vocab_size + 1))
+    bin_counts = counts.view(num_seqs, vocab_size + 1)
+    # Exclude the padding bin (index == vocab_size) from outputs.
+    trimmed = bin_counts[:, :vocab_size]
+    mask = trimmed > 0
+    return trimmed, mask
 
 
