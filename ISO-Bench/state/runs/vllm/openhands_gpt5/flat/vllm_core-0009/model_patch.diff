+    # Broadcast repetition penalties without allocating a full repeated tensor
+    # by using masked operations on the rows that require changes.
+    rep = repetition_penalties.view(-1, 1)
+    mask_any = (prompt_mask | output_mask)
+    if mask_any.any():
+        rows = mask_any.any(dim=1)
+        logits_rows = logits[rows]
+        mask_rows = mask_any[rows]
+        rep_rows = rep[rows]
+        pos = (logits_rows > 0) & mask_rows
+        neg = (logits_rows <= 0) & mask_rows
