+        # Initialize with an arbitrary element (dict preserves insertion order
+        # but we only need one element here).
+        it = iter(self.free_table.values())
+        best = next(it)
+        best_ts = best.last_accessed
+        best_h = best.num_hashed_tokens
+
+        for blk in it:
+            ts = blk.last_accessed
+            if ts < best_ts:
+                best = blk
+                best_ts = ts
+                best_h = blk.num_hashed_tokens
+            elif ts == best_ts and blk.num_hashed_tokens > best_h:
+                best = blk
+                best_h = blk.num_hashed_tokens
+
+        # Remove and return the chosen block.
