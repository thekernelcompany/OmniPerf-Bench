diff --git a/vllm/utils.py b/vllm/utils.py
index a92b77e..d057051 100644
--- a/vllm/utils.py
+++ b/vllm/utils.py
@@ -787,9 +787,24 @@ def async_tensor_h2d(
     target_device: Union[str, torch.device],
     pin_memory: bool,
 ) -> torch.Tensor:
-    """Asynchronously create a tensor and copy it from host to device."""
-    t = torch.tensor(data, dtype=dtype, pin_memory=pin_memory, device="cpu")
-    return t.to(device=target_device, non_blocking=True)
+    """Asynchronously create a tensor and copy it from host to device.
+
+    Optimizations:
+    - Fast-path if `data` is already a CPU tensor to avoid redundant allocation
+    - Prefer `as_tensor` to reduce copies for array-like inputs
+    - Defer pinning to a separate step to avoid allocator zero-fill
+    """
+    if isinstance(data, torch.Tensor):
+        t_cpu = data.to(dtype=dtype, device="cpu", copy=False)
+        if pin_memory and not t_cpu.is_pinned():
+            with contextlib.suppress(RuntimeError):
+                t_cpu = t_cpu.pin_memory()
+    else:
+        t_cpu = torch.as_tensor(data, dtype=dtype, device="cpu")
+        if pin_memory:
+            with contextlib.suppress(RuntimeError):
+                t_cpu = t_cpu.pin_memory()
+    return t_cpu.to(device=target_device, non_blocking=True)
 
 
