diff --git a/vllm/model_executor/layers/utils.py b/vllm/model_executor/layers/utils.py
index dfe7102..9795bc4 100644
--- a/vllm/model_executor/layers/utils.py
+++ b/vllm/model_executor/layers/utils.py
@@ -12,10 +12,12 @@ def get_token_bin_counts_and_mask(
 ) -> Tuple[torch.Tensor, torch.Tensor]:
     # Compute the bin counts for the tokens.
     # vocab_size + 1 for padding.
-    bin_counts = torch.zeros((num_seqs, vocab_size + 1),
+    bin_counts = torch.empty((num_seqs, vocab_size + 1),
                              dtype=torch.long,
                              device=tokens.device)
+    bin_counts.zero_()
     bin_counts.scatter_add_(1, tokens, torch.ones_like(tokens))
+    # ensure padded column does not leak into mask when vocab_size slicing removes it
     bin_counts = bin_counts[:, :vocab_size]
     mask = bin_counts > 0
 
