+#!/usr/bin/env python3
+"""
+Benchmark script for EP MOE pre-reorder Triton kernels.
+
+This script benchmarks the performance of the pre_reorder_triton_kernel and
+deepep_permute_triton_kernel used in expert parallelism for Mixture of Experts models.
+"""
+
+import argparse
+import sys
+import time
+from typing import Dict, List
+
+import torch
+import triton
+
+# Add the python directory to the path
+sys.path.insert(0, "python")
+
+from sglang.srt.layers.moe.ep_moe.kernels import (
+    deepep_permute_triton_kernel,
+    deepep_run_moe_deep_preprocess,
+    pre_reorder_triton_kernel,
+    run_moe_ep_preproess,
+)
+
+
+def benchmark_kernel(
+    kernel_fn,
+    grid,
+    args,
+    num_warmup: int = 10,
+    num_runs: int = 100,
+) -> float:
+    """
+    Benchmark a Triton kernel.
+    
+    Args:
+        kernel_fn: The kernel function to benchmark
+        grid: Grid configuration for the kernel
+        args: Arguments to pass to the kernel
+        num_warmup: Number of warmup iterations
+        num_runs: Number of benchmark iterations
+        
+    Returns:
+        Average execution time in milliseconds
+    """
+    # Warmup
+    for _ in range(num_warmup):
+        kernel_fn[grid](*args)
+    torch.cuda.synchronize()
+    
+    # Benchmark
+    start = time.perf_counter()
+    for _ in range(num_runs):
+        kernel_fn[grid](*args)
+    torch.cuda.synchronize()
+    end = time.perf_counter()
+    
+    avg_time_ms = (end - start) / num_runs * 1000
+    return avg_time_ms
+
+
+def benchmark_pre_reorder_kernel(
+    num_tokens: int,
+    hidden_size: int,
+    topk: int,
+    num_experts: int,
+    block_size: int = 128,
+    num_runs: int = 100,
+) -> Dict[str, float]:
+    """
+    Benchmark the pre_reorder_triton_kernel.
+    
+    Args:
+        num_tokens: Number of input tokens
+        hidden_size: Hidden dimension size
+        topk: Number of top experts per token
+        num_experts: Total number of experts
+        block_size: Block size for the kernel
+        num_runs: Number of benchmark iterations
+        
+    Returns:
+        Dictionary with benchmark results
+    """
+    device = torch.device("cuda")
+    
+    # Create test data
+    input_data = torch.randn(num_tokens, hidden_size, device=device, dtype=torch.float16)
+    gateup_input = torch.empty(num_tokens * topk, hidden_size, device=device, dtype=torch.float16)
+    topk_ids = torch.randint(0, num_experts, (num_tokens, topk), device=device, dtype=torch.int32)
+    
+    # Preprocess to get src2dst
+    _, src2dst, _ = run_moe_ep_preproess(topk_ids, num_experts)
+    
+    # Benchmark
+    grid = (num_tokens,)
+    args = (
+        input_data,
+        gateup_input,
+        src2dst,
+        topk_ids,
+        None,  # a1_scales_ptr
+        0,     # start_expert_id
+        num_experts - 1,  # end_expert_id
+        topk,
+        hidden_size,
+        block_size,
+    )
+    
+    avg_time_ms = benchmark_kernel(pre_reorder_triton_kernel, grid, args, num_runs=num_runs)
+    
+    # Calculate throughput
+    total_elements = num_tokens * hidden_size * topk
+    throughput_gb_s = (total_elements * 2) / (avg_time_ms / 1000) / 1e9  # 2 bytes per fp16
+    
+    return {
+        "avg_time_ms": avg_time_ms,
+        "throughput_gb_s": throughput_gb_s,
+    }
+
+
+def benchmark_deepep_permute_kernel(
+    num_tokens: int,
+    hidden_size: int,
+    topk: int,
+    num_experts: int,
+    block_size: int = 128,
+    num_runs: int = 100,
+) -> Dict[str, float]:
+    """
+    Benchmark the deepep_permute_triton_kernel.
+    
+    Args:
+        num_tokens: Number of input tokens
+        hidden_size: Hidden dimension size
+        topk: Number of top experts per token
+        num_experts: Total number of experts
+        block_size: Block size for the kernel
+        num_runs: Number of benchmark iterations
+        
+    Returns:
+        Dictionary with benchmark results
+    """
+    device = torch.device("cuda")
+    
+    # Create test data
+    input_data = torch.randn(num_tokens, hidden_size, device=device, dtype=torch.float16)
+    gateup_input = torch.empty(num_tokens * topk, hidden_size, device=device, dtype=torch.float16)
+    topk_ids = torch.randint(0, num_experts, (num_tokens, topk), device=device, dtype=torch.int32)
+    
+    # Preprocess to get src2dst
+    _, src2dst, _ = deepep_run_moe_deep_preprocess(topk_ids, num_experts)
+    
+    # Benchmark
+    grid = (num_tokens,)
+    args = (
+        input_data,
+        gateup_input,
+        src2dst,
+        topk_ids,
+        None,  # a1_scales_ptr
+        topk,
+        hidden_size,
+        block_size,
+    )
+    
+    avg_time_ms = benchmark_kernel(deepep_permute_triton_kernel, grid, args, num_runs=num_runs)
+    
+    # Calculate throughput
+    total_elements = num_tokens * hidden_size * topk
+    throughput_gb_s = (total_elements * 2) / (avg_time_ms / 1000) / 1e9  # 2 bytes per fp16
+    
+    return {
+        "avg_time_ms": avg_time_ms,
+        "throughput_gb_s": throughput_gb_s,
+    }
+
+
+def benchmark_preprocess(
+    num_tokens: int,
+    topk: int,
+    num_experts: int,
+    num_runs: int = 100,
+) -> Dict[str, float]:
+    """
+    Benchmark the preprocessing functions.
+    
+    Args:
+        num_tokens: Number of input tokens
+        topk: Number of top experts per token
+        num_experts: Total number of experts
+        num_runs: Number of benchmark iterations
+        
+    Returns:
+        Dictionary with benchmark results
+    """
+    device = torch.device("cuda")
+    topk_ids = torch.randint(0, num_experts, (num_tokens, topk), device=device, dtype=torch.int32)
+    
+    # Warmup
+    for _ in range(10):
+        run_moe_ep_preproess(topk_ids, num_experts)
+    torch.cuda.synchronize()
+    
+    # Benchmark
+    start = time.perf_counter()
+    for _ in range(num_runs):
+        run_moe_ep_preproess(topk_ids, num_experts)
+    torch.cuda.synchronize()
+    end = time.perf_counter()
+    
+    avg_time_ms = (end - start) / num_runs * 1000
+    
+    return {
+        "avg_time_ms": avg_time_ms,
+    }
+
+
+def print_results(name: str, config: Dict, results: Dict):
+    """Print benchmark results in a formatted way."""
+    print(f"\n{name}")
+    print("-" * 80)
+    print(f"Config: num_tokens={config['num_tokens']}, hidden_size={config.get('hidden_size', 'N/A')}, "
+          f"topk={config['topk']}, num_experts={config['num_experts']}")
+    print(f"Average time: {results['avg_time_ms']:.4f} ms")
+    if 'throughput_gb_s' in results:
+        print(f"Throughput: {results['throughput_gb_s']:.2f} GB/s")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Benchmark EP MOE pre-reorder Triton kernels")
+    parser.add_argument("--num-tokens", type=int, nargs="+", default=[512, 1024, 2048],
+                        help="Number of tokens to benchmark")
+    parser.add_argument("--hidden-size", type=int, nargs="+", default=[2048, 4096],
+                        help="Hidden sizes to benchmark")
+    parser.add_argument("--topk", type=int, nargs="+", default=[2, 4],
+                        help="Top-k values to benchmark")
+    parser.add_argument("--num-experts", type=int, nargs="+", default=[8, 16],
+                        help="Number of experts to benchmark")
+    parser.add_argument("--block-size", type=int, default=128,
+                        help="Block size for kernels")
+    parser.add_argument("--num-runs", type=int, default=100,
+                        help="Number of benchmark runs")
+    
+    args = parser.parse_args()
+    
+    if not torch.cuda.is_available():
+        print("CUDA not available, exiting")
+        return
+    
+    print("=" * 80)
+    print("EP MOE Pre-Reorder Triton Kernels Benchmark")
+    print("=" * 80)
+    
+    # Generate test configurations
+    configs = []
+    for num_tokens in args.num_tokens:
+        for hidden_size in args.hidden_size:
+            for topk in args.topk:
+                for num_experts in args.num_experts:
+                    configs.append({
+                        "num_tokens": num_tokens,
+                        "hidden_size": hidden_size,
+                        "topk": topk,
+                        "num_experts": num_experts,
+                    })
+    
+    # Benchmark each configuration
+    for config in configs:
+        print(f"\n{'=' * 80}")
+        print(f"Configuration: {config}")
+        print(f"{'=' * 80}")
+        
+        # Benchmark pre_reorder_kernel
+        results = benchmark_pre_reorder_kernel(
+            **config,
+            block_size=args.block_size,
+            num_runs=args.num_runs,
+        )
+        print_results("pre_reorder_triton_kernel", config, results)
+        
+        # Benchmark deepep_permute_kernel
+        results = benchmark_deepep_permute_kernel(
+            **config,
+            block_size=args.block_size,
+            num_runs=args.num_runs,
+        )
+        print_results("deepep_permute_triton_kernel", config, results)
+        
+        # Benchmark preprocess
+        preprocess_config = {k: v for k, v in config.items() if k != "hidden_size"}
+        results = benchmark_preprocess(
+            **preprocess_config,
+            num_runs=args.num_runs,
+        )
+        print_results("run_moe_ep_preproess", preprocess_config, results)
+
+
+if __name__ == "__main__":
+    main()
