+def _cumsum_with_pad(tensor: torch.Tensor, dtype: torch.dtype = torch.int32) -> torch.Tensor:
+    """Helper function to compute cumsum with left padding efficiently."""
+    cumsum_result = torch.cumsum(tensor, dim=0, dtype=dtype)
+    return torch.nn.functional.pad(cumsum_result, (1, 0))
+
+
+def _to_int32(tensor: torch.Tensor) -> torch.Tensor:
+    """Convert tensor to int32 only if not already int32."""
+    if tensor.dtype == torch.int32:
+        return tensor
+    return tensor.to(torch.int32)
