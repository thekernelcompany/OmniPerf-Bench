diff --git a/python/sglang/srt/disaggregation/mooncake/transfer_engine.py b/python/sglang/srt/disaggregation/mooncake/transfer_engine.py
index 5643af7..930db12 100644
--- a/python/sglang/srt/disaggregation/mooncake/transfer_engine.py
+++ b/python/sglang/srt/disaggregation/mooncake/transfer_engine.py
@@ -90,5 +90,41 @@ class MooncakeTransferEngine:
 
         return ret
 
+    def batch_transfer_sync(
+        self, session_id: str, transfers: list[tuple[int, int, int]]
+    ) -> int:
+        """
+        Synchronously transfer multiple data chunks in a batch.
+        
+        Args:
+            session_id: The session ID for the transfer
+            transfers: List of (buffer, peer_buffer_address, length) tuples
+            
+        Returns:
+            0 on success, negative on failure
+        """
+        if not transfers:
+            return 0
+        
+        try:
+            # Process all transfers in a batch to reduce overhead
+            # This is more efficient than calling transfer_sync_write multiple times
+            for buffer, peer_buffer_address, length in transfers:
+                ret = self.engine.transfer_sync_write(
+                    session_id, buffer, peer_buffer_address, length
+                )
+                if ret != 0:
+                    logger.debug(
+                        "Failed to transfer data from %s to %s - %s.",
+                        buffer,
+                        session_id,
+                        peer_buffer_address,
+                    )
+                    return ret
+            return 0
+        except Exception as e:
+            logger.debug(f"Batch transfer failed with exception: {e}")
+            return -1
+
     def get_session_id(self):
         return self.session_id
