@@ -90,5 +90,41 @@ class MooncakeTransferEngine:
 
         return ret
 
+    def batch_transfer_sync(
+        self,
+        session_id: str,
+        buffers: list[int],
+        peer_buffer_addresses: list[int],
+        lengths: list[int],
+    ) -> int:
+        """Synchronously transfer multiple data chunks to the specified addresses in batch."""
+        if not buffers or len(buffers) != len(peer_buffer_addresses) or len(buffers) != len(lengths):
+            logger.error("Invalid batch transfer parameters: mismatched list lengths")
+            return -1
+
+        try:
+            # Attempt to use batch transfer if available
+            ret = self.engine.batch_transfer_sync_write(
+                session_id, buffers, peer_buffer_addresses, lengths
+            )
+        except AttributeError:
+            # Fallback to sequential transfers if batch API not available
+            for buffer, peer_addr, length in zip(buffers, peer_buffer_addresses, lengths):
+                ret = self.transfer_sync(session_id, buffer, peer_addr, length)
+                if ret != 0:
+                    return ret
+            return 0
+        except Exception:
+            # Mark transfer request as failed
+            ret = -1
+
+        if ret < 0:
+            logger.debug(
+                "Failed to batch transfer data from buffers to %s.",
+                session_id,
+            )
+
+        return ret
+
     def get_session_id(self):
