+    def transfer_batch_sync(
+        self,
+        session_id: str,
+        buffers: Sequence[int],
+        peer_buffer_addresses: Sequence[int],
+        lengths: Sequence[int],
+    ) -> int:
+        """Batch transfer multiple segments.
+
+        Uses a native batch API if available in mooncake; otherwise falls back to
+        issuing multiple transfer_sync calls sequentially.
+        Returns 0 on success, or the first non-zero/negative status encountered.
+        """
+        # Fast path: use engine's batch write if available
+        engine = self.engine
+        try:
+            batch_fn = getattr(engine, "transfer_batch_sync_write", None)
+        except Exception:
+            batch_fn = None
+
+        if batch_fn is not None:
+            try:
+                ret = batch_fn(session_id, list(buffers), list(peer_buffer_addresses), list(lengths))
+            except Exception:
+                ret = -1
+            return ret
+
+        # Fallback path
+        for b, p, l in zip(buffers, peer_buffer_addresses, lengths):
+            r = self.transfer_sync(session_id, b, p, l)
+            if r != 0:
+                return r
+        return 0
+
     def get_session_id(self):
         return self.session_id
