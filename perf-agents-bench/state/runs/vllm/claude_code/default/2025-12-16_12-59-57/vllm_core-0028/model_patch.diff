-
-                if patch_newline_mask is not None:
-                    patch_newline_mask_lst.extend(patch_newline_mask)
-
-            image_inputs = {
-                "pixel_values": torch.cat(pixel_values_lst),
-                "num_patches": num_patches,
-            }
-            if patch_pixel_values_lst:
