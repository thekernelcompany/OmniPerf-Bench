-def align_workers(value, op):
-    group = get_world_group().cpu_group
-    world_size = torch.distributed.get_world_size()
-    if world_size <= 1:
-        return value
-    value_t = torch.tensor(value, device='cpu')
-    torch.distributed.all_reduce(value_t, op=op, group=group)
-    return value_t.item()
