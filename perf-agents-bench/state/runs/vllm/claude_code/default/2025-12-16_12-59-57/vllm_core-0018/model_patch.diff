-
-template <typename T>
-__device__ __forceinline__ _B16x4 addx4(const _B16x4& inp1,
-                                        const _B16x4& inp2) {
-  union tmpcvt {
-    uint16_t u;
-    _Float16 f;
-    __hip_bfloat16 b;
-  } t1, t2, res;
-  _B16x4 ret;
-  if constexpr (std::is_same<T, _Float16>::value) {
-  #pragma unroll
-    for (int i = 0; i < 4; i++) {
-      t1.u = inp1[i];
-      t2.u = inp2[i];
-      res.f = t1.f + t2.f;
-      ret[i] = res.u;
-    }
-    return ret;
-  } else if constexpr (std::is_same<T, __hip_bfloat16>::value) {
-  #pragma unroll
-    for (int i = 0; i < 4; i++) {
-      t1.u = inp1[i];
-      t2.u = inp2[i];
-      res.b = t1.b + t2.b;
-      ret[i] = res.u;
-    }
-    return ret;
-  } else {
-    static_assert(false, "unsupported 16b dtype");
-  }
-}
