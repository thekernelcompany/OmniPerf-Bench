-class MllamaVisionEncoder(nn.Module):
-
-    def __init__(
-        self,
-        config: config_mllama.MllamaVisionConfig,
-        quant_config: Optional[QuantizationConfig],
-        num_layers: int = 32,
-        is_gated: bool = False,
-        output_hidden_states=None,
-        prefix: str = "",
