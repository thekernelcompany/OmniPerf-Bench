+            params_dtype=params_dtype,
+            weight_loader=weight_loader)
+
+        input_scale = Parameter(torch.empty(1, dtype=torch.float32),
+                                requires_grad=False)
+
+        layer.register_parameter("input_scale", input_scale)
+        set_weight_attrs(input_scale, {
+            "weight_loader": weight_loader,
+            "ignore_warning": True,
+        })
