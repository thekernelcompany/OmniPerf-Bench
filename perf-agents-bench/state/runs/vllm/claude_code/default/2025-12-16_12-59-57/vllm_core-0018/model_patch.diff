-            "{\n"
-            "  lop3.b32 %0, %0, %1, %2, %3;\n"
-            "}\n"
-            : "+r"(r[ii + 1])
-            : "n"(high_nib_mask), "n"(xor_mask), "n"(and_xor_imm_lut));
