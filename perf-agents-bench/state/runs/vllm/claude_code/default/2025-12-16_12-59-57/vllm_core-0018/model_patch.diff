-#
-# String / Print Manipulation
-#
-
-
-def trim_string_front(string, width):
-    if len(string) > width:
-        offset = len(string) - width + 3
-        string = string[offset:]
-        if len(string) > 3:
-            string = "..." + string[3:]
-    return string
-
-
-def trim_string_back(string, width):
-    if len(string) > width:
-        offset = len(string) - width + 3
-        string = string[:-offset]
-        if len(string) > 3:
-            string = string + "..."
-    return string
