-    if match_len == 0:
-        return
-
-    start_idx = 0
-    while start_idx < prompt_len - match_len + 1:
-        end_idx = start_idx + match_len
-
-        if token_ids[start_idx:end_idx] == match_ids:
-            yield _TokenMatch(start_idx=start_idx, end_idx=end_idx)
-
-            # Exclude overlapping matches
-            start_idx = end_idx
-        else:
-            start_idx += 1
