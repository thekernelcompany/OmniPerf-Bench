-# -- Declare variables to be passed into your templates.
-
-# -- Image configuration
-image:
-  # -- Image repository
-  repository: "vllm/vllm-openai"
-  # -- Image tag
-  tag: "latest"
-  # -- Container launch command
-  command: ["vllm", "serve", "/data/", "--served-model-name", "opt-125m", "--dtype", "bfloat16", "--host", "0.0.0.0", "--port", "8000"]
-
-# -- Container port
-containerPort: 8000
-# -- Service name
