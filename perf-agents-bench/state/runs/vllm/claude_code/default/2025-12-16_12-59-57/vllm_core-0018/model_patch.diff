-        mm_data = dict(mm_data)
-        videos = mm_data.pop("videos", [])
-        assert isinstance(videos, list)
-
-        if not videos:
-            return super()._call_hf_processor(
-                prompt=prompt,
-                mm_data=mm_data,
-                mm_kwargs=mm_kwargs,
