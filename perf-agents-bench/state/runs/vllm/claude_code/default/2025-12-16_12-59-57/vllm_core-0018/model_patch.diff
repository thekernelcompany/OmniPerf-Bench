@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: Apache-2.0
+import torch
+from torch import Generator
+
+from vllm.v1.sample.ops.topk_topp_sampler import apply_top_k_top_p
+
+DEVICE = "cuda"
+
+BATCH_SIZE = 1024
+VOCAB_SIZE = 128 * 1024
+
+
+def test_topk_impl_equivalance():
+
+    with torch.device(DEVICE):
+        generator = Generator(device=DEVICE).manual_seed(33)
+
+        logits = torch.rand((BATCH_SIZE, VOCAB_SIZE), generator=generator)
+
+        # Random top-k values between 1 and 9.
+        k = torch.randint(1, 10, (BATCH_SIZE, ), generator=generator)
+
+        # Set k=vocab_size for ~50% of requests in the batch (top-k disabled).
+        k.masked_fill_(
+            torch.rand((BATCH_SIZE, ), generator=generator) > 0.5,
+            VOCAB_SIZE,
+        )
+
+        # Top-p disabled for all requests.
+        p = torch.ones((BATCH_SIZE, ))
+
+        # Apply top-k
+        result_logits = apply_top_k_top_p(logits.clone(), k, p)
+
+        # Verify results
+        for i in range(BATCH_SIZE):
+            ki = k[i].item()
+            if ki < VOCAB_SIZE:
+                # Check that only top-k values remain
+                topk_vals, _ = torch.topk(logits[i], ki)
+                min_topk = topk_vals[-1].item()
+
+                # All values >= min_topk should be kept
+                kept_mask = result_logits[i] > float('-inf')
+                expected_mask = logits[i] >= min_topk
+
+                assert kept_mask.sum() <= ki + 1  # Allow for ties
+
+
+def test_topk_topp_combined():
+    """Test combined top-k and top-p sampling."""
+
+    with torch.device(DEVICE):
+        generator = Generator(device=DEVICE).manual_seed(42)
+
+        logits = torch.rand((BATCH_SIZE, VOCAB_SIZE), generator=generator)
+
+        # Random top-k values
+        k = torch.randint(10, 100, (BATCH_SIZE, ), generator=generator)
+
+        # Random top-p values
+        p = torch.rand((BATCH_SIZE, ), generator=generator) * 0.5 + 0.5
+
+        # Apply top-k and top-p
+        result_logits = apply_top_k_top_p(logits.clone(), k, p)
+
+        # Verify that some filtering occurred
+        inf_mask = result_logits == float('-inf')
+        assert inf_mask.any(), "Expected some logits to be filtered"
+
+
+def test_no_filtering():
+    """Test that no filtering occurs when top-k and top-p are disabled."""
+
+    with torch.device(DEVICE):
+        generator = Generator(device=DEVICE).manual_seed(123)
+
+        logits = torch.rand((BATCH_SIZE, VOCAB_SIZE), generator=generator)
+
+        # Disable both top-k and top-p
+        k = torch.full((BATCH_SIZE,), VOCAB_SIZE)
+        p = torch.ones((BATCH_SIZE,))
+
+        # Apply (should be no-op)
+        result_logits = apply_top_k_top_p(logits.clone(), k, p)
+
+        # Verify no change
+        assert torch.allclose(logits, result_logits), "Expected no filtering"
+
+
+if __name__ == "__main__":
+    # Check CUDA availability
+    if not torch.cuda.is_available():
+        print("CUDA not available, skipping tests")
+    else:
+        print("Running test_topk_impl_equivalance...")
+        test_topk_impl_equivalance()
+        print("✓ test_topk_impl_equivalance passed")
+
+        print("Running test_topk_topp_combined...")
+        test_topk_topp_combined()
+        print("✓ test_topk_topp_combined passed")
+
+        print("Running test_no_filtering...")
+        test_no_filtering()
+        print("✓ test_no_filtering passed")
+
+        print("\nAll tests passed!")
