-  // but blocked_product does not support dynamic strides so we implement the
-  // equivalent manually,
-  //   new_shape = (N, packed_K, L) * (1, eles_per_storage, 1) -> (N, K, L)
-  //   new_stride = (s0, s1, s2) * (eles_per_storage, 1, eles_per_storage)
