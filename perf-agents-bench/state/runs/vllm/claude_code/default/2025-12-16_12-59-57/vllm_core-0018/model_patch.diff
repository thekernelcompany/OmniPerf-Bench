-      auto r = lut_4bit_to_8bit_convert<0xF8, 0xF9, 0xFA, 0xFB,  //
-                                        0xFC, 0xFD, 0xFE, 0xFF,  //
-                                        0x00, 0x01, 0x02, 0x03,  //
