-    auto convert_A = [&, a_vec = Int<COVERSION_WIDTH>{}](int k_block,
-                                                         int read_stage) {
-      load_extra_info_to_registers(partitioned_extra_info,
-                                   copy_partitions_extra_info, k_block,
