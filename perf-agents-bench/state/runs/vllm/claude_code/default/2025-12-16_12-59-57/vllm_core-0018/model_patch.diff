-__device__ inline void sub_zp(FragB& frag_b, half2& frag_zp, int i) {
-  half2 zp = __half2half2(reinterpret_cast<__half*>(&frag_zp)[i]);
-  frag_b[0] = __hsub2(frag_b[0], zp);
-  frag_b[1] = __hsub2(frag_b[1], zp);
