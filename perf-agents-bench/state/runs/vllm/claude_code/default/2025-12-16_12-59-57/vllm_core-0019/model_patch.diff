-def generate(
-    llm: vllm.LLM,
-    inputs: Tuple[str, SamplingParams, Optional[LoRARequest]],
-):
-    prompts, sampling_param, lora_request = inputs
-    outputs = llm.generate(prompts, sampling_param, lora_request=lora_request)
