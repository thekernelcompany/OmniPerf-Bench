-        if hasattr(
-                model_runner,
-                "return_hidden_states") and model_runner.return_hidden_states:
-            raise ValueError(
-                "return_hidden_states is not supported for TP1DraftModelRunner."
-            )
-        super().__init__(model_runner)
-
-        self.indices_of_seq_with_bonus_tokens = None
