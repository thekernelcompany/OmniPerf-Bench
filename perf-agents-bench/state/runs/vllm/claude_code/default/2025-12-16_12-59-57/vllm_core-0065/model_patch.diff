-  assert(codebook_partition_sizes.size(0) <= 4);
-  for (; i <  codebook_partition_sizes.size(0); ++i, ++cumulative_size)
-  {
-    *cumulative_size = codebook_partition_sizes[i].item<int>() + last;
-    last = *cumulative_size;
