-
-    def forward(self, hidden_states: torch.Tensor):
-        if self.is_moe_layer:
-            final_hidden_states = self.local_moe_fused(hidden_states)
-        else:
-            final_hidden_states = self.mlp(hidden_states)
-        return final_hidden_states
