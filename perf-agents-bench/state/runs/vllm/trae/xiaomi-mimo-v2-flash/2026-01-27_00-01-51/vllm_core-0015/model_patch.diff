+template <typename scalar_t>
+__global__ void moe_align_block_size_single_kernel(
+    const scalar_t* __restrict__ topk_ids,
+    int32_t* __restrict__ sorted_token_ids, int32_t* __restrict__ expert_ids,
+    int32_t* __restrict__ total_tokens_post_pad, int32_t num_experts,
+    int32_t block_size, size_t numel, int32_t max_num_tokens_padded,
+    int32_t* __restrict__ cumsum_buffer) {
+  // Single-kernel implementation that works for all batch sizes
+  // Uses shared memory for counting and avoids atomic operations to global memory
+  
+  extern __shared__ int32_t shared_mem[];
+  
+  // Shared memory layout:
+  // - First num_experts + 1 elements: cumsum
+  // - Remaining: tokens_cnts for all threads
+  int32_t* cumsum = shared_mem;
+  int32_t* tokens_cnts = (int32_t*)(shared_mem + num_experts + 1);
+  
+  const size_t tid = threadIdx.x;
+  const size_t stride = blockDim.x;
+  const int num_threads = blockDim.x;
+  
+  // Initialize per-thread token counts
+  for (int i = 0; i < num_experts; ++i) {
+    tokens_cnts[(threadIdx.x + 1) * num_experts + i] = 0;
+  }
+  
+  // Count tokens per expert (each thread counts a subset)
+  for (size_t i = tid; i < numel; i += stride) {
+    ++tokens_cnts[(threadIdx.x + 1) * num_experts + topk_ids[i]];
+  }
+  
+  __syncthreads();
+  
+  // Prefix sum across threads for each expert
+  if (threadIdx.x < num_experts) {
+    tokens_cnts[threadIdx.x] = 0;
+    for (int i = 1; i <= num_threads; ++i) {
+      tokens_cnts[i * num_experts + threadIdx.x] +=
+          tokens_cnts[(i - 1) * num_experts + threadIdx.x];
+    }
+  }
+  
+  __syncthreads();
+  
+  // Compute cumulative sum and total padded tokens
+  if (threadIdx.x == 0) {
+    cumsum[0] = 0;
+    for (int i = 1; i <= num_experts; ++i) {
+      cumsum[i] =
+          cumsum[i - 1] +
+          CEILDIV(tokens_cnts[num_threads * num_experts + i - 1], block_size) *
+              block_size;
+    }
+    *total_tokens_post_pad = static_cast<int32_t>(cumsum[num_experts]);
+    
+    // Write cumsum to global memory for use in sorting
+    for (int i = 0; i <= num_experts; ++i) {
+      cumsum_buffer[i] = cumsum[i];
+    }
+  }
+  
+  __syncthreads();
+  
+  // Fill expert_ids
+  if (threadIdx.x < num_experts) {
+    for (int i = cumsum[threadIdx.x]; i < cumsum[threadIdx.x + 1];
+         i += block_size) {
+      expert_ids[i / block_size] = threadIdx.x;
+    }
+  }
+  
+  // Fill remaining expert_ids with 0
+  const size_t fill_start_idx = cumsum[num_experts] / block_size + threadIdx.x;
+  const size_t expert_ids_size = CEILDIV(max_num_tokens_padded, block_size);
+  for (size_t i = fill_start_idx; i < expert_ids_size; i += blockDim.x) {
+    expert_ids[i] = 0;
+  }
+  
+  // Initialize sorted_token_ids with numel (only for regions we'll write to)
+  if (threadIdx.x < num_experts) {
+    for (int i = cumsum[threadIdx.x]; i < cumsum[threadIdx.x + 1]; ++i) {
+      sorted_token_ids[i] = numel;
+    }
+  }
+  
+  __syncthreads();
+  
+  // Sort tokens by expert
+  for (size_t i = tid; i < numel; i += stride) {
+    int32_t expert_id = topk_ids[i];
+    int32_t rank_post_pad =
+        tokens_cnts[threadIdx.x * num_experts + expert_id] + cumsum[expert_id];
+    sorted_token_ids[rank_post_pad] = i;
+    ++tokens_cnts[threadIdx.x * num_experts + expert_id];
+  }
+}
+
