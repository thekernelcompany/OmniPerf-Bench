         assert allocator.get_prefix_cache_hit_rate() > 0.99
 
+    @staticmethod
+    @pytest.mark.parametrize("num_blocks", [4])
+    @pytest.mark.parametrize("block_size", [16])
+    @pytest.mark.parametrize("num_sequences", [8])
+    def test_mark_blocks_as_computed_is_noop(num_blocks: int, block_size: int,
+                                              num_sequences: int):
+        """Verify that mark_blocks_as_computed is a no-op and doesn't raise
+        NotImplementedError. This is an optimization to avoid unnecessary
+        operations since computed status is tracked incrementally.
+        """
+        allocator = PrefixCachingBlockAllocator(num_blocks=num_blocks,
+                                                block_size=block_size)
+        
+        # Common token IDs for shared prefix
+        common_prefix_blocks = 4
+        common_token_ids = list(range(block_size * common_prefix_blocks))
+        
+        # Allocate blocks for multiple sequences with common prefixes
+        for seq_idx in range(num_sequences):
+            prev_block = None
+            for block_idx in range(common_prefix_blocks):
+                start_idx = block_idx * block_size
+                end_idx = start_idx + block_size
+                token_ids = common_token_ids[start_idx:end_idx]
+                
+                block = allocator.allocate_immutable_block(
+                    prev_block=prev_block,
+                    token_ids=token_ids
+                )
+                prev_block = block
+        
+        # This should not raise NotImplementedError and should be a no-op
+        allocator.mark_blocks_as_computed([])
+        
+        # Verify cache hit rate is correct (all sequences after the first
+        # should hit the cache)
+        assert allocator.get_prefix_cache_hit_rate() > 0.8
+
